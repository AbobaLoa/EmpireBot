{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmpireBot",
  "version": "1.1.0",
  "identifier": "com.abobaloa.empirebot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EmpireBot Live",
        "width": 1380,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
